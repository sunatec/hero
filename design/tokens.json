{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "0xInChain / 链上情报局 design tokens v1 (M1). Direction: B Dossier (site) + A Pane system (toolbox). Dark only in V1.",
  "color": {
    "ink": {
      "0": { "$type": "color", "$value": "#14161A", "$description": "页面底色（墨灰）" },
      "1": { "$type": "color", "$value": "#1B1E23", "$description": "纸面区块 / 档案卡" },
      "2": { "$type": "color", "$value": "#252930", "$description": "悬停 / 窗格标题栏" }
    },
    "line": { "$type": "color", "$value": "#343841", "$description": "1px 分隔线（装饰性，非文字）" },
    "bone": {
      "default": { "$type": "color", "$value": "#E9E4D8", "$description": "正文。ink-0 14.28 / ink-1 13.17 / ink-2 11.51" },
      "dim": { "$type": "color", "$value": "#A8A398", "$description": "次要文字。ink-0 7.21 / ink-1 6.65 / ink-2 5.81" }
    },
    "stamp": {
      "default": { "$type": "color", "$value": "#E8604A", "$description": "唯一强调色：印章、关键句、描边。ink-0 5.35 / ink-1 4.94；ink-2 4.31 → 在 ink-2 上仅用于大号粗体或非文字" },
      "fill": { "$type": "color", "$value": "#A93322", "$description": "主按钮底色，配 bone 文字 5.20" },
      "fill-hover": { "$type": "color", "$value": "#B83A26", "$description": "主按钮 hover，配 bone 文字 4.51" }
    },
    "dossier": { "$type": "color", "$value": "#C9A96A", "$description": "编号 / 批注 / 元信息（卷宗黄）。ink-0 8.08 / ink-1 7.45 / ink-2 6.51" },
    "gain": { "$type": "color", "$value": "#6FBF8E", "$description": "仅数据：正收益。ink-0 8.21 / ink-2 6.62" },
    "loss": { "$type": "color", "$value": "#E07A68", "$description": "仅数据：负收益。ink-0 6.17 / ink-2 4.97" },
    "redact": { "$type": "color", "$value": "#0B0C0E", "$description": "涂黑条" },
    "focus": { "$type": "color", "$value": "#E8604A", "$description": "焦点环 2px" }
  },
  "font": {
    "family": {
      "display-zh": { "$type": "fontFamily", "$value": ["Noto Serif SC", "Songti SC", "serif"] },
      "display-latin": { "$type": "fontFamily", "$value": ["Newsreader", "Georgia", "serif"] },
      "body": { "$type": "fontFamily", "$value": ["Noto Sans SC", "PingFang SC", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] },
      "data": { "$type": "fontFamily", "$value": ["Martian Mono", "IBM Plex Mono", "ui-monospace", "monospace"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "black": { "$type": "fontWeight", "$value": 900 }
    },
    "size": {
      "h1": { "$type": "dimension", "$value": "clamp(64px, 10vw, 128px)" },
      "h2": { "$type": "dimension", "$value": "clamp(32px, 4vw, 48px)" },
      "h3": { "$type": "dimension", "$value": "24px" },
      "lead": { "$type": "dimension", "$value": "clamp(18px, 1.6vw, 22px)" },
      "body": { "$type": "dimension", "$value": "17px", "$description": "移动端 16px" },
      "meta": { "$type": "dimension", "$value": "13px" },
      "data": { "$type": "dimension", "$value": "13px" },
      "micro": { "$type": "dimension", "$value": "11px", "$description": "仅限大写 Latin 标签，letter-spacing 0.12em" }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.05 },
      "heading": { "$type": "number", "$value": 1.25 },
      "body": { "$type": "number", "$value": 1.75 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "section-desktop": { "$type": "dimension", "$value": "128px" },
    "section-mobile": { "$type": "dimension", "$value": "80px" },
    "gutter-mobile": { "$type": "dimension", "$value": "20px" }
  },
  "layout": {
    "container": { "$type": "dimension", "$value": "1280px" },
    "measure": { "$type": "dimension", "$value": "68ch", "$description": "正文最大行宽（中文 ≤ 38 字）" },
    "grid-site": { "$type": "number", "$value": 8, "$description": "主站 8 栏编辑网格，第 1 栏为批注栏" },
    "grid-tools": { "$type": "number", "$value": 12, "$description": "工具箱 12 栏窗格，gap 0" },
    "breakpoints": { "$type": "other", "$value": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280 } }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0", "$description": "窗格、工具箱按钮" },
    "file": { "$type": "dimension", "$value": "2px", "$description": "档案卡、主按钮" }
  },
  "border": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "stamp": { "$type": "dimension", "$value": "3px double" }
  },
  "motion": {
    "duration": {
      "hover": { "$type": "duration", "$value": "150ms" },
      "underline": { "$type": "duration", "$value": "200ms" },
      "stamp": { "$type": "duration", "$value": "200ms" },
      "redact": { "$type": "duration", "$value": "300ms" },
      "rule-draw": { "$type": "duration", "$value": "400ms" },
      "row-stagger": { "$type": "duration", "$value": "60ms" },
      "count": { "$type": "duration", "$value": "800ms" }
    },
    "easing": {
      "out": { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1] },
      "stamp": { "$type": "cubicBezier", "$value": [0.3, 1.4, 0.5, 1] }
    }
  },
  "stamp": {
    "rotation": { "$type": "other", "$value": "-6deg" },
    "states": {
      "$type": "other",
      "$value": { "open": "进行中", "hit": "命中", "invalidated": "失效", "stopped": "止损", "expired": "超时", "void": "作废" }
    }
  }
}
