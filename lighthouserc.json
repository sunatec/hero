{
	"ci": {
		"collect": {
			"startServerCommand": "pnpm exec next start -p 3100",
			"startServerReadyPattern": "Ready",
			"url": [
				"http://localhost:3100/",
				"http://localhost:3100/ledger",
				"http://localhost:3100/ledger/IC-2026-0001",
				"http://localhost:3100/tools",
				"http://localhost:3100/join"
			],
			"numberOfRuns": 3,
			"settings": { "chromeFlags": "--headless=new --no-sandbox" }
		},
		"assert": {
			"assertions": {
				"categories:performance": ["warn", { "minScore": 0.9, "aggregationMethod": "median" }],
				"categories:accessibility": ["error", { "minScore": 0.95 }],
				"categories:best-practices": ["error", { "minScore": 0.95 }],
				"categories:seo": ["error", { "minScore": 1 }],
				"cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
				"largest-contentful-paint": ["warn", { "maxNumericValue": 2000, "aggregationMethod": "median" }]
			}
		},
		"upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
	}
}
