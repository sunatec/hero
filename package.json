{
  "name": "0xinchain-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm content:validate && next build",
    "start": "next start",
    "typecheck": "pnpm -s content:build && tsc --noEmit",
    "lint": "biome check --css-parse-tailwind-directives=true app components lib scripts content-collections.ts site.config.ts next.config.ts vitest.config.ts playwright.config.ts e2e",
    "format": "biome check --write --css-parse-tailwind-directives=true app components lib scripts content-collections.ts site.config.ts next.config.ts vitest.config.ts playwright.config.ts e2e",
    "content:validate": "tsx scripts/validate-content.ts",
    "copy:lint": "tsx scripts/lint-copy.ts",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm content:validate && pnpm copy:lint && pnpm test",
    "prepare": "husky",
    "content:build": "content-collections build",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@biomejs/biome"
    ]
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@content-collections/cli": "^0.1.9",
    "@content-collections/core": "^0.15.3",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/next": "^0.2.11",
    "@fontsource/martian-mono": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
