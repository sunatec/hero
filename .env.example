# Canonical origin for canonical / OG URLs (M12), e.g. https://0xinchain.com — open-items B12.
# Unset: Vercel previews use their own URL. INDEXABLE=1 lets robots.txt allow crawling outside production.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile (M9). Test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Telegram bot that receives /join applications (M9). Without all three server keys
# POST /api/apply answers 503; without the site key /join shows a "DM us on TG" fallback.
# e2e overrides the upstream hosts (TURNSTILE_VERIFY_URL, TG_API_BASE) — see playwright.config.ts.
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=

# Plausible analytics domain (M14)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
